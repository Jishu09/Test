# ===== Telegram Credentials (my.telegram.org) =====
API_ID=
API_HASH=

# ===== Bot Token (BotFather) =====
BOT_TOKEN=

# ===== MongoDB (mongodb.com/cloud/atlas free tier works) =====
MONGO_URI=
DB_NAME=

# ===== Owner / Sudo =====
OWNER_ID=
SUDO_USERS=

# ===== Log Channel (bot must be admin) =====
LOG_CHANNEL=

# ===== Force Subscribe (comma separated channel ids, bot must be admin) =====
FSUB_CHANNELS=
# Set to True if you want Join-Request mode (private channel with approval) for FSub
FSUB_JOIN_REQUEST=True

# ===== Misc =====
DEFAULT_CAPTION={filename}
TIMEZONE=Asia/Dhaka
PORT=8080


# ===== Start Pictures (Comma separated URLs) =====
START_PICS=https://graph.org/file/058a5dc7dbb2d9a6d33c6-8673a6326f3a4c45ea.jpg, https://graph.org/file/e600a0155fc5bf2a1d4ac-f01e9c19eba9a02830.jpg, https://graph.org/file/68a19c7488d1bc92b5e5b-4eb29f97b92dd133e2.jpg

